{
    "name": "response",
    "description": "The format of the response.",
    "schema": {
        "type": "object",
        "description": "The response.",
        "additionalProperties": false,
        "properties": {
            "response": {
                "anyOf": [
                    {
                        "type": "object",
                        "description": "The default response format where you simply reply to the user's message.",
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string",
                                "description": "The type of the response.",
                                "enum": ["reply"]
                            },
                            "reply": {
                                "type": "string",
                                "description": "The content of your reply."
                            }
                        },
                        "required": ["type", "reply"]
                    },
                    {
                        "type": "object",
                        "description": "Use this response format if the user wants to modify the textboard.",
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string",
                                "description": "The type of the response.",
                                "enum": ["mail_to_ionvop"]
                            },
                            "reply": {
                                "type": "string",
                                "description": "The content of your reply to the user. You may include a remark regarding your modifications to the textboard."
                            },
                            "editType": {
                                "type": "string",
                                "description": "Whether to append your content to the textboard or overwrite the entirety of its contents. Your content will automatically be prefixed with `\\n` when appending.",
                                "enum": ["append", "overwrite"]
                            },
                            "content": {
                                "type": "string",
                                "description": "The content that will be appended or overwritten on the textboard."
                            }
                        },
                        "required": ["type", "reply", "editType", "content"]
                    },
                    {
                        "type": "object",
                        "description": "Use this response format if the user is still making severely inappropriate messages. Only use this if you have already warned them atleast twice.",
                        "additionalProperties": false,
                        "properties": {
                            "type": {
                                "type": "string",
                                "description": "The type of the response.",
                                "enum": ["timeout"]
                            },
                            "timeoutType": {
                                "type": "string",
                                "description": "The user will be redirected to dedicated pages based on what kind of inappropriate behavior they were making. Use 'horny_jail' if the user was being sexually crude.",
                                "enum": ["hate_speech", "horny_jail", "general"]
                            },
                            "reason": {
                                "type": "string",
                                "description": "Your last message to the user that will be displayed on the timeout page."
                            }
                        },
                        "required": ["type", "timeoutType", "reason"]
                    }
                ]
            }
        },
        "required": ["response"]
    },
    "strict": true
}